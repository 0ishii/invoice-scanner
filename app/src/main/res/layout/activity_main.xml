<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111827">

    <!-- Camera Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Toolbar Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="#99000000"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="QUÉT HÓA ĐƠN GIAO HÀNG"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Offline / Online"
            android:textColor="#93C5FD"
            android:textSize="12sp"
            android:background="#333B82F6"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp" />
    </LinearLayout>

    <!-- Center Viewfinder Frame Guide -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp">
        <View
            android:id="@+id/scanGuide"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_gravity="center"
            android:background="@android:drawable/dialog_holo_light_frame" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="125dp"
            android:background="#88000000"
            android:padding="6dp"
            android:text="Căn khung vào phần tiêu đề hóa đơn"
            android:textColor="#E0E7FF"
            android:textSize="12sp" />
    </FrameLayout>

    <!-- Shutter Button Floating -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnCapture"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="280dp"
        android:backgroundTint="#2563EB"
        app:fabSize="normal"
        app:tint="#FFFFFF"
        android:src="@android:drawable/ic_menu_camera" />

    <!-- Loading Indicator -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- Bottom Result Sheet -->
    <androidx.cardview.widget.CardView
        android:id="@+id/bottomSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:cardBackgroundColor="#1F2937"
        app:cardCornerRadius="16dp"
        app:cardElevation="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KẾT QUẢ BÓC TÁCH"
                android:textColor="#9CA3AF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- Row 1: Số Đơn Đặt Hàng -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#111827"
                android:padding="10dp"
                android:layout_marginBottom="8dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Số Đơn Đặt Hàng (SO):"
                        android:textColor="#9CA3AF"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/tvOrderNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chưa quét"
                        android:textColor="#60A5FA"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <Button
                    android:id="@+id/btnCopyOrder"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="Copy"
                    android:textSize="11sp"
                    android:backgroundTint="#2563EB" />
            </LinearLayout>

            <!-- Row 2: Số Lệnh Giao Hàng -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#111827"
                android:padding="10dp"
                android:layout_marginBottom="8dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Số Lệnh Giao Hàng (DO):"
                        android:textColor="#9CA3AF"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/tvDeliveryNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chưa quét"
                        android:textColor="#34D399"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <Button
                    android:id="@+id/btnCopyDelivery"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="Copy"
                    android:textSize="11sp"
                    android:backgroundTint="#059669" />
            </LinearLayout>

            <!-- Row 3: Tuyến Đường -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#111827"
                android:padding="10dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tuyến Đường:"
                        android:textColor="#9CA3AF"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/tvRoute"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chưa quét"
                        android:textColor="#FBBF24"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <Button
                    android:id="@+id/btnCopyRoute"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="Copy"
                    android:textSize="11sp"
                    android:backgroundTint="#D97706" />
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
